# Copy to apps/api/.env
# Leave MONGODB_URI empty to use a local embedded MongoDB stored in .data/mongo
MONGODB_URI=
JWT_SECRET=change-me-in-production
PORT=4000
# Google Gemini powers the in-app assistant. Without a key it runs in rule-based offline mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
