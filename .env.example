# Copy to apps/api/.env
# Leave MONGODB_URI empty to use a local embedded MongoDB stored in .data/mongo
MONGODB_URI=
JWT_SECRET=change-me-in-production
PORT=4000
# Google Gemini powers the in-app assistant. Without a key it runs in rule-based offline mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# "Switch role" between the demo accounts: on outside production; set to 1 to allow it in production (e.g. the Render demo), 0 to turn it off.
ROLE_SWITCH=
# OpenStreetMap lookups for "Find more places" (comma-separated Overpass servers). Leave empty for the public ones.
OVERPASS_URL=
