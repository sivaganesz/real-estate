# Copy to apps/api/.env and fill in. Validated at startup (Phase 1 step 1.2).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27018/real_estate

# Long random string for signing access tokens (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=

# Origins allowed by CORS, and the base URL used in email links
ADMIN_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5174
APP_BASE_URL=http://localhost:5173

# Local file storage (uploaded logos, property media, import files)
UPLOAD_DIR=./uploads

# Email: "console" prints emails to the log (local development); "resend" sends real emails
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Real Estate <no-reply@example.com>"

# Basic auth for /api/docs outside local development, format user:password
SWAGGER_BASIC_AUTH=

# First Super Admin, created by `pnpm --filter @real-estate/api seed` (only used by the seed script).
# Password: at least 6 characters with a letter and a number. Change it after the first login.
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# Phase 3 (Perfox AI)
# PERFOX_API_BASE=
# PERFOX_API_KEY=
# MCP_BEARER_TOKEN=
