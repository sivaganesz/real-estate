    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "i18next": "^27.2.3",
    "immer": "^10.2.0",
    "lucide-react": "^1.77.0",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
